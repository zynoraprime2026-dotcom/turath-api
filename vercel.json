{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/api/scholars",
      "destination": "/api/index.js?__route=scholars"
    },
    {
      "source": "/api/scholars/:id",
      "destination": "/api/index.js?__route=scholars&__id=:id"
    },
    {
      "source": "/api/rijal",
      "destination": "/api/index.js?__route=rijal"
    },
    {
      "source": "/api/rijal/:id",
      "destination": "/api/index.js?__route=rijal&__id=:id"
    }
  ]
}